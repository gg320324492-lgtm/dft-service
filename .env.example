# 复制为 .env 或直接 set 环境变量; 全部可省略 (默认值见 dft_service/config.py)

# --- 服务 ---
DFT_SERVICE_HOST=127.0.0.1
DFT_SERVICE_PORT=8620
# 未设置 = 鉴权关闭 (仅限本机/内网); 对外部署必须设置
# DFT_SERVICE_API_KEY=change-me-to-a-long-random-string

# --- 存储 ---
# DFT_SERVICE_OUTPUT_ROOT=E:/dft-service/data/jobs
# DFT_SERVICE_DB_URL=E:/dft-service/data/dft_service.db

# --- 计算环境 ---
# DFT_SERVICE_SCISOFTWARE=E:/sci-software
# DFT_SERVICE_SCICHEM_PYTHON=E:/sci-software/conda-envs/scichem/python.exe
# DFT_SERVICE_GAUSSIAN_BIN=E:/sci-software/g16w/g16.exe
# DFT_SERVICE_WSL_DISTRO=Ubuntu-24.04   (默认 auto: 自动探测装了 gmx 的发行版)

# --- 网络 ---
# DFT_SERVICE_CORS_ORIGINS=*   (逗号分隔; 前端跨域直连时配置具体源)
