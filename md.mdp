integrator = steep

nsteps = 50
cutoff-scheme = Verlet
ns-type = simple
rcoulomb = 0.9
rvdw = 0.9
coulombtype = PME
pme-order = 4
fourier-spacing = 0.16
tcoupl = no
pcoupl = no
gen-vel = yes
gen-temp = 300
gen-seed = -1
tcoupl = V-rescale
tau-t = 0.1
ref-t = 300
pcoupl = no
nstxout-compressed = 1000
nstenergy = 1000
nstlog = 1000
